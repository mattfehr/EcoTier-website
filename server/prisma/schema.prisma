generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // From Supabase settings
}

model users {
  id         String   @id @default(dbgenerated()) @db.Uuid // match auth.users.id
  username   String   @unique
  email      String   @unique
  createTime DateTime @default(now())

  follows   follows[]   @relation("Follower")
  following follows[]   @relation("Following")
  questions questions[]
  cartItems cartitem[]
  favorites favorites[]
  orders    orders[]    @relation("CustomerOrders")
  comments  comments[]
  products  products[]  @relation("CreatorProducts")
}

model follows {
  followerID  String @db.Uuid
  followingID String @db.Uuid

  follower  users @relation("Follower", fields: [followerID], references: [id])
  following users @relation("Following", fields: [followingID], references: [id])

  @@id([followerID, followingID])
}

model questions {
  questionID   Int     @id @default(autoincrement())
  userID       String  @db.Uuid
  questionType String // enum-like usage
  content      String
  response     String?

  user users @relation(fields: [userID], references: [id])
}

model cartitem {
  userID    String @db.Uuid
  productID Int
  quantity  Int

  user    users    @relation(fields: [userID], references: [id])
  product products @relation(fields: [productID], references: [productID])

  @@id([userID, productID])
}

model favorites {
  userID    String @db.Uuid
  productID Int

  user    users    @relation(fields: [userID], references: [id])
  product products @relation(fields: [productID], references: [productID])

  @@id([userID, productID])
}

model orders {
  orderNumber  Int      @id @default(autoincrement())
  customerID   String   @db.Uuid
  address      String
  totalPrice   Float
  purchaseTime DateTime @default(now())

  customer   users       @relation("CustomerOrders", fields: [customerID], references: [id])
  orderItems orderitem[]
}

model orderitem {
  orderNumber     Int
  productID       Int
  quantity        Int
  priceAtPurchase Int

  order   orders   @relation(fields: [orderNumber], references: [orderNumber])
  product products @relation(fields: [productID], references: [productID])

  @@id([orderNumber, productID])
}

model comments {
  userID    String   @db.Uuid
  productID Int
  content   String
  postTime  DateTime @default(now())

  user    users    @relation(fields: [userID], references: [id])
  product products @relation(fields: [productID], references: [productID])

  @@id([userID, productID])
}

model products {
  productID   Int      @id @default(autoincrement())
  productType String
  name        String   @unique
  creatorID   String   @db.Uuid
  price       Float
  public      Boolean
  createTime  DateTime @default(now())
  updateTime  DateTime @updatedAt
  description String?
  PIN         String?

  creator    users       @relation("CreatorProducts", fields: [creatorID], references: [id])
  orderItems orderitem[]
  cartItems  cartitem[]
  favorites  favorites[]
  comments   comments[]

  towersAsPart  towercomponents[] @relation("Part")
  towersAsTower towercomponents[] @relation("Tower")
}

model towercomponents {
  towerID  Int
  partID   Int
  position Int
  quantity Int

  tower products @relation("Tower", fields: [towerID], references: [productID])
  part  products @relation("Part", fields: [partID], references: [productID])

  @@id([towerID, partID])
}
