generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userID     String   @id @default(uuid()) @map("user_id")
  username   String   @unique
  email      String   @unique
  password   String
  createTime DateTime @default(now()) @map("create_time")

  products      Product[]
  cartItems     CartItem[]
  favorites     Favorite[]
  orders        Order[]
  comments      Comment[]
  questions     Question[]
  following     Follow[] @relation("Following")
  followers     Follow[] @relation("Follower")

  @@map("users")
}

model Product {
  productID    String   @id @default(uuid()) @map("product_id")
  productType  ProductType @map("product_type")
  creatorID    String?  @map("creator_id")
  name         String
  price        Float
  description  String?
  isPublic     Boolean  @default(true) @map("is_public")
  createTime   DateTime @default(now()) @map("create_time")
  updateTime   DateTime @updatedAt @map("update_time")
  sensorPin    String?  @map("sensor_pin")

  creator      User?    @relation(fields: [creatorID], references: [userID])
  cartItems    CartItem[]
  favorites    Favorite[]
  comments     Comment[]
  towerParts   TowerComponent[] @relation("Component")
  towerOwned   TowerComponent[] @relation("Tower")
  orderItems   OrderItem[]

  @@map("products")
}

model TowerComponent {
  towerID   String @map("tower_id")
  partID    String @map("part_id")
  position  Int?
  quantity  Int @default(1)

  tower     Product @relation("Tower", fields: [towerID], references: [productID], onDelete: Cascade)
  part      Product @relation("Component", fields: [partID], references: [productID], onDelete: Cascade)

  @@id([towerID, partID])
  @@map("tower_components")
}

model CartItem {
  userID    String @map("user_id")
  productID String @map("product_id")
  quantity  Int @default(1)

  user      User    @relation(fields: [userID], references: [userID], onDelete: Cascade)
  product   Product @relation(fields: [productID], references: [productID], onDelete: Cascade)

  @@id([userID, productID])
  @@map("cart_items")
}

model Favorite {
  userID    String @map("user_id")
  productID String @map("product_id")

  user      User    @relation(fields: [userID], references: [userID], onDelete: Cascade)
  product   Product @relation(fields: [productID], references: [productID], onDelete: Cascade)

  @@id([userID, productID])
  @@map("favorites")
}

model Order {
  orderNumber    String   @id @default(uuid()) @map("order_number")
  customerID     String   @map("customer_id")
  address        String
  totalPrice     Float    @map("total_price")
  purchaseTime   DateTime @default(now()) @map("purchase_time")

  customer       User      @relation(fields: [customerID], references: [userID], onDelete: Cascade)
  orderItems     OrderItem[]

  @@map("orders")
}

model OrderItem {
  orderNumber     String @map("order_number")
  productID       String @map("product_id")
  quantity        Int
  priceAtPurchase Float @map("price_at_purchase")

  order           Order   @relation(fields: [orderNumber], references: [orderNumber], onDelete: Cascade)
  product         Product @relation(fields: [productID], references: [productID], onDelete: Cascade)

  @@id([orderNumber, productID])
  @@map("order_items")
}

model Comment {
  userID     String @map("user_id")
  productID  String @map("product_id")
  content    String
  postTime   DateTime @default(now()) @map("post_time")

  user       User    @relation(fields: [userID], references: [userID], onDelete: Cascade)
  product    Product @relation(fields: [productID], references: [productID], onDelete: Cascade)

  @@id([userID, productID])
  @@map("comments")
}

model Follow {
  followerID  String @map("follower_id")
  followingID String @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower    User @relation("Follower", fields: [followerID], references: [userID], onDelete: Cascade)
  following   User @relation("Following", fields: [followingID], references: [userID], onDelete: Cascade)

  @@id([followerID, followingID])
  @@map("follows")
}

model Question {
  questionID   String   @id @default(uuid()) @map("question_id")
  userID       String   @map("user_id")
  questionType QuestionType @map("question_type")
  content      String
  response     String?
  createdAt    DateTime @default(now()) @map("created_at")

  user         User @relation(fields: [userID], references: [userID], onDelete: Cascade)

  @@map("questions")
}

enum ProductType {
  tower
  module
  addon
}

enum QuestionType {
  question
  feedback
}
