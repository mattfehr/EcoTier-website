generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // From Supabase settings
}

model User {
  id           String   @id @default(dbgenerated()) @db.Uuid
  username     String   @unique
  email        String   @unique
  createTime   DateTime @default(now())
  profileImage String?
  bio          String?

  follows   Follow[]   @relation("Follower")
  following Follow[]   @relation("Following")
  questions Question[]
  cartItems CartItem[]
  favorites Favorite[]
  orders    Order[]    @relation("CustomerOrders")
  comments  Comment[]
  products  Product[]  @relation("CreatorProducts")

  @@map("users")
}

model Follow {
  followerID  String @db.Uuid
  followingID String @db.Uuid

  follower  User @relation("Follower", fields: [followerID], references: [id])
  following User @relation("Following", fields: [followingID], references: [id])

  @@id([followerID, followingID])
  @@map("follow")
}

model Question {
  questionID   Int     @id @default(autoincrement())
  userID       String  @db.Uuid
  questionType String
  content      String
  response     String?

  user User @relation(fields: [userID], references: [id])

  @@map("question")
}

model CartItem {
  userID    String @db.Uuid
  productID Int
  quantity  Int

  user    User    @relation(fields: [userID], references: [id])
  product Product @relation(fields: [productID], references: [productID])

  @@id([userID, productID])
  @@map("cartitem")
}

model Favorite {
  userID    String @db.Uuid
  productID Int

  user    User    @relation(fields: [userID], references: [id])
  product Product @relation(fields: [productID], references: [productID])

  @@id([userID, productID])
  @@map("favorite")
}

model Order {
  orderNumber   Int      @id @default(autoincrement())
  customerID    String   @db.Uuid
  fullName      String
  address       String
  totalPrice    Float
  purchaseTime  DateTime @default(now())
  paymentStatus String   @default("pending") // e.g. "pending", "paid", "failed"
  transactionID String? // from Stripe/PayPal later

  customer   User        @relation("CustomerOrders", fields: [customerID], references: [id])
  orderItems OrderItem[]

  @@map("order")
}

model OrderItem {
  orderNumber     Int
  productID       Int
  quantity        Int
  priceAtPurchase Int

  order   Order   @relation(fields: [orderNumber], references: [orderNumber])
  product Product @relation(fields: [productID], references: [productID])

  @@id([orderNumber, productID])
  @@map("orderitem")
}

model Comment {
  userID    String   @db.Uuid
  productID Int
  content   String
  postTime  DateTime @default(now())

  user    User    @relation(fields: [userID], references: [id])
  product Product @relation(fields: [productID], references: [productID])

  @@id([userID, productID])
  @@map("comment")
}

model Product {
  productID   Int      @id @default(autoincrement())
  productType String
  name        String   @unique
  creatorID   String   @db.Uuid
  price       Float
  public      Boolean
  createTime  DateTime @default(now())
  updateTime  DateTime @updatedAt
  description String?
  PIN         String?
  imageURL    String?

  // 3D model file import
  modelURL        String? // Supabase storage URL
  modelFileType   String? // e.g. "STL", "OBJ", "3MF", "STEP"
  modelSizeBytes  Int? // file size in bytes
  modelFilename   String? // original filename
  modelPreviewURL String? // optional: future thumbnail preview

  creator    User        @relation("CreatorProducts", fields: [creatorID], references: [id])
  orderItems OrderItem[]
  cartItems  CartItem[]
  favorites  Favorite[]
  comments   Comment[]

  towersAsPart  TowerComponent[] @relation("Part")
  towersAsTower TowerComponent[] @relation("Tower")

  //Relation to ProductConfig for editor templates
  config ProductConfig?

  @@map("product")
}

model TowerComponent {
  towerID  Int
  partID   Int
  position Int
  quantity Int

  tower Product @relation("Tower", fields: [towerID], references: [productID])
  part  Product @relation("Part", fields: [partID], references: [productID])

  @@id([towerID, partID])
  @@map("towercomponent")
}

model ProductConfig {
  id        Int    @id @default(autoincrement())
  productID Int    @unique
  template  String // e.g. "tower_basic"
  params    Json // Example: { height: 120, sites: 24, led_rings: 2 }

  product Product @relation(fields: [productID], references: [productID])

  @@map("product_config")
}
