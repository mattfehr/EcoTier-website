generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // From Supabase settings
}

model User {
  id           String   @id @default(dbgenerated()) @db.Uuid // match auth.users.id
  username     String   @unique
  email        String   @unique
  createTime   DateTime @default(now())
  profileImage String? // URL path to supabase storage bucket
  bio          String?

  follows   Follow[]   @relation("Follower")
  following Follow[]   @relation("Following")
  questions Question[]
  cartItems CartItem[]
  favorites Favorite[]
  orders    Order[]    @relation("CustomerOrders")
  comments  Comment[]
  products  Product[]  @relation("CreatorProducts")
}

model Follow {
  followerID  String @db.Uuid
  followingID String @db.Uuid

  follower  User @relation("Follower", fields: [followerID], references: [id])
  following User @relation("Following", fields: [followingID], references: [id])

  @@id([followerID, followingID])
}

model Question {
  questionID   Int     @id @default(autoincrement())
  userID       String  @db.Uuid
  questionType String
  content      String
  response     String?

  user User @relation(fields: [userID], references: [id])
}

model CartItem {
  userID    String @db.Uuid
  productID Int
  quantity  Int

  user    User    @relation(fields: [userID], references: [id])
  product Product @relation(fields: [productID], references: [productID])

  @@id([userID, productID])
}

model Favorite {
  userID    String @db.Uuid
  productID Int

  user    User    @relation(fields: [userID], references: [id])
  product Product @relation(fields: [productID], references: [productID])

  @@id([userID, productID])
}

model Order {
  orderNumber  Int      @id @default(autoincrement())
  customerID   String   @db.Uuid
  address      String
  totalPrice   Float
  purchaseTime DateTime @default(now())

  customer   User        @relation("CustomerOrders", fields: [customerID], references: [id])
  orderItems OrderItem[]
}

model OrderItem {
  orderNumber     Int
  productID       Int
  quantity        Int
  priceAtPurchase Int

  order   Order   @relation(fields: [orderNumber], references: [orderNumber])
  product Product @relation(fields: [productID], references: [productID])

  @@id([orderNumber, productID])
}

model Comment {
  userID    String   @db.Uuid
  productID Int
  content   String
  postTime  DateTime @default(now())

  user    User    @relation(fields: [userID], references: [id])
  product Product @relation(fields: [productID], references: [productID])

  @@id([userID, productID])
}

model Product {
  productID   Int      @id @default(autoincrement())
  productType String // enum-like usage
  name        String   @unique
  creatorID   String   @db.Uuid
  price       Float
  public      Boolean
  createTime  DateTime @default(now())
  updateTime  DateTime @updatedAt
  description String?
  PIN         String?
  imageURL    String?

  creator    User        @relation("CreatorProducts", fields: [creatorID], references: [id])
  orderItems OrderItem[]
  cartItems  CartItem[]
  favorites  Favorite[]
  comments   Comment[]

  towersAsPart  TowerComponent[] @relation("Part")
  towersAsTower TowerComponent[] @relation("Tower")
}

model TowerComponent {
  towerID  Int
  partID   Int
  position Int
  quantity Int

  tower Product @relation("Tower", fields: [towerID], references: [productID])
  part  Product @relation("Part", fields: [partID], references: [productID])

  @@id([towerID, partID])
}
