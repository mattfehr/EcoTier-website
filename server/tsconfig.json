{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["esnext"],
    "esModuleInterop": true,
    "rootDir": "../",                  // allow server + shared
    "outDir": "./dist",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "baseUrl": ".",                    // optional, helps with path aliases later
    "paths": {
      "@shared/*": ["../shared/*"]     // optional alias for imports
    }
  },
  "include": ["src", "../shared"],
  "exclude": ["node_modules", "dist"]
}
